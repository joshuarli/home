#!/bin/sh
set -eu
uid=$(id -u)
runtime=/run/user/$uid
if [ ! -d "$runtime" ] || [ -L "$runtime" ] || [ "$(stat -c %u:%a "$runtime")" != "$uid:700" ]; then
	echo "home-session: $runtime is missing or not private; run: doas rc-service home-runtime restart" >&2
	exit 1
fi
export XDG_RUNTIME_DIR="$runtime" XDG_SESSION_TYPE=wayland PATH="$HOME/.local/bin:$PATH"
unset DISPLAY
log=$runtime/dwl.log
status=0
/usr/local/bin/dwl -s 'foot <&-' >"$log" 2>&1 || status=$?
if [ "$status" -ne 0 ]; then
	echo "home-session: dwl exited with status $status; see $log" >&2
	exit "$status"
fi
