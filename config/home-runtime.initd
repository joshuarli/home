#!/sbin/openrc-run
description="Create private runtime directory for home"
depend() { need localmount; before seatd; }
start() {
 uid=$(cat /etc/home-session-uid) || return 1
 case "$uid" in ''|*[!0-9]*) return 1;; esac
 [ "$uid" -ge 1000 ] || return 1
 [ ! -L /run/user ] || return 1
 checkpath -d -m 0755 -o root:root /run/user || return 1
 [ ! -L "/run/user/$uid" ] || return 1
 checkpath -d -m 0700 -o "$uid:$uid" "/run/user/$uid"
}
