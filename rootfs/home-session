#!/bin/sh
set -eu

runtime=/run/user/1000
logfile="$runtime/home-session.log"

if [ "$(id -u)" -ne 1000 ] || [ "$(id -g)" -ne 1000 ]; then
    echo "home-session: refusing to start outside josh's account" >&2
    exec /bin/ash -l
fi
if [ "$(tty 2>/dev/null || true)" != /dev/tty1 ]; then
    echo "home-session: refusing to start outside tty1" >&2
    exec /bin/ash -l
fi
if [ ! -d "$runtime" ] || [ -L "$runtime" ] ||
    [ "$(stat -c '%u:%g:%a' "$runtime" 2>/dev/null || true)" != 1000:1000:700 ]; then
    echo "home-session: XDG_RUNTIME_DIR is not a private josh-owned directory" >&2
    exec /bin/ash -l
fi

umask 077
export HOME=/home/josh
export USER=josh
export LOGNAME=josh
export SHELL=/bin/ash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=${LANG:-en_US.UTF-8}
export LC_ALL=${LC_ALL:-en_US.UTF-8}
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR=$runtime
unset DISPLAY

: > "$logfile"
chmod 0600 "$logfile"
printf '%s\n' "home-session: starting dwl on $(tty)" >> "$logfile"

# The QEMU harness can opt into the pixman renderer through a root-created
# fw_cfg flag.  The kernel's raw fw_cfg file is root-readable only, so the
# root-owned runtime service projects this one explicit VM choice into /run.
# A physical boot never sees the flag and therefore uses wlroots' normal DRM
# renderer selection for the Intel GPU.
renderer_file=/run/home-installer-qemu-renderer
if [ -r "$renderer_file" ] && [ "$(tr -d '\n' < "$renderer_file")" = pixman ]; then
	export WLR_RENDERER=pixman
	# QEMU's explicit std VGA device is the only virtual GPU in this branch.
	# Resolve its DRM node through the bochs driver identity and, when udev
	# provides one, the stable PCI by-path name.  Never assume that the kernel
	# assigned this device card0; the physical Intel boot never sees this
	# override.
	find_qemu_drm_device() {
		drm_device=
		drm_matches=0
		for candidate in /dev/dri/by-path/*-card; do
			[ -L "$candidate" ] || continue
			resolved=$(readlink -f "$candidate" 2>/dev/null || true)
			case "$resolved" in
				/dev/dri/card[0-9]*) ;;
				*) continue ;;
			esac
			card=${resolved##*/}
			driver_link=/sys/class/drm/$card/device/driver
			[ -L "$driver_link" ] || continue
			driver=$(readlink "$driver_link" 2>/dev/null || true)
			[ "${driver##*/}" = bochs-drm ] || continue
		drm_matches=$((drm_matches + 1))
			# Use the resolved device node for wlroots; keep the by-path
			# symlink as the identity that selected it.
			drm_device=$resolved
		done
		if [ "$drm_matches" -eq 1 ]; then
			printf '%s\n' "$drm_device"
			return 0
		fi
		[ "$drm_matches" -eq 0 ] || return 1

		# Some minimal udev setups do not create /dev/dri/by-path.  The
		# sysfs driver link is still a stable identity for selecting the
		# one intended device; the card name is derived, never assumed.
		drm_device=
		drm_matches=0
		for driver_link in /sys/class/drm/card*/device/driver; do
			[ -L "$driver_link" ] || continue
			driver=$(readlink "$driver_link" 2>/dev/null || true)
			[ "${driver##*/}" = bochs-drm ] || continue
			card_path=${driver_link%/device/driver}
			card=${card_path##*/}
			candidate=/dev/dri/$card
			[ -e "$candidate" ] || continue
			drm_matches=$((drm_matches + 1))
			drm_device=$candidate
		done
		[ "$drm_matches" -eq 1 ] || return 1
		printf '%s\n' "$drm_device"
	}

	if qemu_drm_device=$(find_qemu_drm_device); then
		export WLR_DRM_DEVICES=$qemu_drm_device
		printf 'home-session: QEMU pixman renderer selected (%s)\n' \
			"$qemu_drm_device" >> "$logfile"
	else
		printf '%s\n' 'home-session: could not uniquely identify QEMU bochs DRM device' \
			>> "$logfile"
		exec /bin/ash -l
	fi
fi

# dwl v0.8 writes its status stream to the startup command's stdin.  Closing
# foot's stdin is the documented way to avoid a status consumer or a stall.
if /usr/bin/dwl -s '/usr/bin/foot <&-' >> "$logfile" 2>&1; then
	dwl_status=0
else
	dwl_status=$?
fi
printf 'home-session: dwl exited with status %s\n' "$dwl_status" >> "$logfile"
echo "The graphical session ended (dwl status $dwl_status)." >&2
echo "Use Ctrl+Alt+F2 for another recovery console, or run doas reboot." >&2
exec /bin/ash -l
