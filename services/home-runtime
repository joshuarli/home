#!/sbin/openrc-run
description="Create the private XDG_RUNTIME_DIR for the desktop user"

depend() {
	need localmount
	before seatd
}

start() {
	if [ -z "${home_user:-}" ]; then
		eerror "home_user is not set in /etc/conf.d/home-runtime"
		return 1
	fi
	uid=$(id -u "$home_user") || return 1
	gid=$(id -g "$home_user") || return 1
	checkpath -d -m 0755 -o root:root /run/user &&
		checkpath -d -m 0700 -o "$uid:$gid" "/run/user/$uid"
}
